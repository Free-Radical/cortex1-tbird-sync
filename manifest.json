{
  "manifest_version": 2,
  "name": "Cortex1 Thunderbird Sync",
  "version": "1.1.0",
  "description": "Syncs message status and handles thunderlink:// URLs for Thunderbird",
  "author": "Saqib A Khan",
  "homepage_url": "https://github.com/Free-Radical/cortex1-tbird-sync",
  "applications": {
    "gecko": {
      "id": "cortex1-tbird-sync@cortex1.dev",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "messagesRead",
    "messagesUpdate",
    "accountsRead",
    "storage",
    "tabs"
  ],
  "protocol_handlers": [
    {
      "protocol": "thunderlink",
      "name": "ThunderLink Message Handler",
      "uriTemplate": "https://thunderlink.invalid/?msgid=%s"
    }
  ],
  "background": {
    "scripts": ["background.js"]
  }
}
