{
  "manifest_version": 2,
  "name": "Cortex1 Thunderbird Sync",
  "version": "1.5.0",
  "description": "Syncs message status with Thunderbird via polling + optional HTTP push",
  "author": "Saqib A Khan",
  "homepage_url": "https://github.com/Free-Radical/cortex1-tbird-sync",
  "applications": {
    "gecko": {
      "id": "cortex1-tbird-sync@cortex1.dev",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "messagesRead",
    "messagesUpdate",
    "messagesMove",
    "messagesDelete",
    "messagesImport",
    "accountsRead",
    "compose",
    "addressBooks",
    "storage"
  ],
  "background": {
    "scripts": ["background.js"]
  }
}
